# Koneksi ClickHouse
# - Via Docker (Windows / macOS): http://host.docker.internal:8123
# - Via development lokal (npm run dev): http://localhost:8123
CLICKHOUSE_URL=http://host.docker.internal:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Opsional: override manual path Python interpreter (jika kosong, otomatis deteksi .venv)
PYTHON_PATH=

# Opsional: konfigurasi Elasticsearch untuk pipeline course_es
ELASTICSEARCH_URL=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Opsional: path biner clickhouse-client lokal
NUXT_CLICKHOUSE_CLIENT_BIN=